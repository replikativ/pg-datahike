;; PostgreSQL 17 corpus: values rendered as text and as json, by TYPE --
;; concat / || / format() over bool, arrays, bits and records, record_out
;; quoting, the bool cast against its output function, and datum_to_json
;; for datetimes, money, intervals, non-finite numbers, bytea and bits.
;; Captured from a real PostgreSQL after running :setup, not hand-written.
{:setup [
  "drop table if exists jt"
  "create table jt (id int, d date, ts timestamp, tz timestamptz, m money, b bool)"
  "insert into jt values (1, '2026-01-01', '2026-01-01 10:00', '2026-01-01 10:00+00', 1.5, true)"
  "set timezone = 'America/New_York'"
 ]
 :corpus [
  ["concat(true, 'x')" "tx"]
  ["concat(false, 1, null, 'y')" "f1y"]
  ["'a' || true" "atrue"]
  ["concat(array[1,2], 'x')" "{1,2}x"]
  ["concat(B'101', 'x')" "101x"]
  ["concat(row(1,'a\"b'), 'x')" "(1,\"a\"\"b\")x"]
  ["row('a\"b', 1)::text" "(\"a\"\"b\",1)"]
  ["row(true, null)::text" "(t,)"]
  ["concat_ws('-', true, array['a','b c'], 1.50)" "t-{a,\"b c\"}-1.50"]
  ["format('%s %s', true, array[1,2])" "t {1,2}"]
  ["to_jsonb(date '2026-01-01')" "\"2026-01-01\""]
  ["to_jsonb(timestamptz '2026-01-01 10:00+02')" "\"2026-01-01T03:00:00-05:00\""]
  ["to_jsonb(timestamp '2026-01-01 10:00')" "\"2026-01-01T10:00:00\""]
  ["to_jsonb(1.50::money)" "\"$1.50\""]
  ["to_jsonb(true)" "true"]
  ["json_build_object('d', date '2026-01-01', 't', time '10:00')" "{\"d\" : \"2026-01-01\", \"t\" : \"10:00:00\"}"]
  ["jsonb_build_array(interval '1 day', 'NaN'::float8)" "[\"1 day\", \"NaN\"]"]
  ["concat(interval '1 mon 2 days', '!')" "1 mon 2 days!"]
  ["concat(uuid 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11', '')" "a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11"]
  ["concat('\\x0102'::bytea, '')" "\\x0102"]
  ["concat(1.0::float8, ',', 1e20::float8, ',', 0.1::float4)" "1,1e+20,0.1"]
  ["concat(time '10:00', ' ', timetz '10:00+02', ' ', date '2026-01-01')" "10:00:00 10:00:00+02 2026-01-01"]
  ["concat(timestamptz '2026-01-01 10:00+02', '')" "2026-01-01 03:00:00-05"]
  ["array[true, false]::text" "{t,f}"]
  ["array[date '2026-01-01']::text" "{2026-01-01}"]
  ["(array[timestamp '2026-01-01'])::text" "{\"2026-01-01 00:00:00\"}"]
  ["true::text" "true"]
  ["cast(false as text)" "false"]
  ["b::text from (select true as b) s" "true"]
  ["concat(true::text, 'x')" "truex"]
  ["true::varchar" "true"]
  ["to_jsonb(timetz '10:00+02')" "\"10:00:00+02\""]
  ["to_jsonb(time '10:00:00.5')" "\"10:00:00.5\""]
  ["to_jsonb(timestamp '2026-01-01 10:00:00.123')" "\"2026-01-01T10:00:00.123\""]
  ["to_jsonb(timestamptz '2026-01-01 10:00+05:30')" "\"2025-12-31T23:30:00-05:00\""]
  ["to_jsonb('infinity'::timestamp)" "\"infinity\""]
  ["to_jsonb(interval '1 day 2 hours')" "\"1 day 02:00:00\""]
  ["to_jsonb('Infinity'::float8)" "\"Infinity\""]
  ["to_jsonb(date '0044-03-15 BC')" "\"0044-03-15 BC\""]
  ["to_json(timestamptz '2026-01-01 10:00+02')" "\"2026-01-01T03:00:00-05:00\""]
  ["json_build_array(date '2026-01-01', 1.50::money, true, null)" "[\"2026-01-01\", \"$1.50\", true, null]"]
  ["to_jsonb(uuid 'a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11')" "\"a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11\""]
  ["to_jsonb('\\x01'::bytea)" "\"\\\\x01\""]
  ["to_jsonb(B'101')" "\"101\""]
  ["to_jsonb(array[date '2026-01-01', null])" "[\"2026-01-01\", null]"]
  ["to_jsonb(row(1.50::money, timestamptz '2026-01-01 10:00+00'))" "{\"f1\": \"$1.50\", \"f2\": \"2026-01-01T05:00:00-05:00\"}"]
  ["to_jsonb(1.50)" "1.50"]
  ["to_jsonb('a'::text)" "\"a\""]
  ["to_jsonb('{\"a\":1}'::jsonb)" "{\"a\": 1}"]
  ["jsonb_build_object('a', 1, 'b', 'NaN'::float8, 'c', interval '2 days')" "{\"a\": 1, \"b\": \"NaN\", \"c\": \"2 days\"}"]
  ["json_build_object(1, 'x')" "{\"1\" : \"x\"}"]
  ["json_build_array(1, null)" "[1, null]"]
  ["json_build_array(null)" "[null]"]
  ["jsonb_build_object('a', null)" "{\"a\": null}"]
  ["to_jsonb(null::int) is null" "t"]
  ["to_json(null::date) is null" "t"]
  ["json_agg(d) from jt" "[\"2026-01-01\"]"]
  ["jsonb_agg(m) from jt" "[\"$1.50\"]"]
  ["json_agg(tz) from jt" "[\"2026-01-01T05:00:00-05:00\"]"]
  ["row_to_json(jt) from jt" "{\"id\":1,\"d\":\"2026-01-01\",\"ts\":\"2026-01-01T10:00:00\",\"tz\":\"2026-01-01T05:00:00-05:00\",\"m\":\"$1.50\",\"b\":true}"]
  ["to_jsonb(jt) from jt" "{\"b\": true, \"d\": \"2026-01-01\", \"m\": \"$1.50\", \"id\": 1, \"ts\": \"2026-01-01T10:00:00\", \"tz\": \"2026-01-01T05:00:00-05:00\"}"]
  ["json_object_agg(id, ts) from jt" "{ \"1\" : \"2026-01-01T10:00:00\" }"]
  ["jsonb_agg(jt) from jt" "[{\"b\": true, \"d\": \"2026-01-01\", \"m\": \"$1.50\", \"id\": 1, \"ts\": \"2026-01-01T10:00:00\", \"tz\": \"2026-01-01T05:00:00-05:00\"}]"]
  ["jsonb_agg(x order by x desc) from (values (date '2026-01-01'), (date '2026-02-01')) v(x)" "[\"2026-02-01\", \"2026-01-01\"]"]
  ["jsonb_object_agg(k, v) from (values ('a', 1.5::money)) t(k, v)" "{\"a\": \"$1.50\"}"]
  ["json_object_agg(k, v) from (values ('a\"b', 1), ('c', 2)) t(k, v)" "{ \"a\\\"b\" : 1, \"c\" : 2 }"]
 ]}
