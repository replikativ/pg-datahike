;; PostgreSQL 17 corpus: format() (varlena.c text_format) and quote_ident
;; (ruleutils.c quote_identifier). Captured from a real PostgreSQL.
{:setup []
 :corpus [
  ["format('Hello %s', 'World')" "Hello World"]
  ["format('%s %s', 'a')" nil "too few arguments for format()"]
  ["format('%2$s %1$s', 'a', 'b')" "b a"]
  ["format('%1$s %1$s', 'a')" "a a"]
  ["format('|%10s|', 'abc')" "|       abc|"]
  ["format('|%-10s|', 'abc')" "|abc       |"]
  ["format('|%*s|', 6, 'ab')" "|    ab|"]
  ["format('|%-*s|', 6, 'ab')" "|ab    |"]
  ["format('|%*2$s|', 'ab', 5)" nil "too few arguments for format()"]
  ["format('|%1$*2$s|', 'ab', -5)" "|ab   |"]
  ["format('%I', 'Foo bar')" "\"Foo bar\""]
  ["format('%I', 'foo')" "foo"]
  ["format('%L', 'O''Reilly')" "'O''Reilly'"]
  ["format('%L', null)" "NULL"]
  ["format('%s', null)" ""]
  ["format('%I', null)" nil "null values cannot be formatted as an SQL identifier"]
  ["format('%%')" "%"]
  ["format('%x', 1)" nil "unrecognized format() type specifier \"x\""]
  ["format('%')" nil "unterminated format() type specifier"]
  ["format('%1$s %s', 'a', 'b')" "a b"]
  ["format('%s %1$s %s', 'a', 'b')" "a a b"]
  ["format('%0$s', 'a')" nil "format specifies argument 0, but arguments are numbered from 1"]
  ["format('INSERT INTO %I VALUES(%L)', 'Foo', 'O''Reilly')" "INSERT INTO \"Foo\" VALUES('O''Reilly')"]
  ["format(null)" ""]
  ["format('%L', 42)" "'42'"]
  ["format('%L', E'a\\\\b')" "E'a\\\\b'"]
  ["format('%-5s|', null)" "     |"]
  ["format('%3$s', 'a', 'b')" nil "too few arguments for format()"]
  ["format('%I', '')" "\"\""]
  ["format('%5s|%-5s|', 'é', 'é')" "    é|é    |"]
  ["format('%s %s', 1.50::money, date '2026-01-01')" "$1.50 2026-01-01"]
  ["format('%*s', '3', 'x')" "  x"]
  ["format('%1$s', 'a', 'b')" "a"]
  ["format('%I', 'int')" "\"int\""]
  ["format('%I', 'a$b')" "\"a$b\""]
  ["format('%L', 1.5)" "'1.5'"]
  ["format('%*1$s', 4)" nil "too few arguments for format()"]
  ["quote_ident('foo')" "foo"]
  ["quote_ident('Foo')" "\"Foo\""]
  ["quote_ident('select')" "\"select\""]
  ["quote_ident('a b')" "\"a b\""]
  ["quote_ident('_x1')" "_x1"]
  ["quote_ident('1x')" "\"1x\""]
  ["quote_ident('user')" "\"user\""]
  ["quote_ident('int')" "\"int\""]
 ]}
