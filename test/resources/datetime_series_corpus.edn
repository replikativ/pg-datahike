;; PostgreSQL 17 corpus: generate_series over timestamps, OVERLAPS, and
;; date/timestamp values through derived tables -- under TimeZone
;; America/New_York. Captured from a real PostgreSQL, not hand-written.
;; Each entry is [expr expected-first-row] or [expr nil error-message].
[
  ["count(*) from generate_series(timestamptz '2026-03-07 12:00-05', timestamptz '2026-03-09 12:00-04', interval '1 day')" "3"]
  ["string_agg(g::text, ',' order by g) from generate_series(timestamptz '2026-03-07 12:00-05', timestamptz '2026-03-09 12:00-04', interval '1 day') g" "2026-03-07 12:00:00-05,2026-03-08 12:00:00-04,2026-03-09 12:00:00-04"]
  ["string_agg(g::text, ',' order by g) from generate_series(timestamp '2026-03-07', timestamp '2026-03-08', interval '12 hours') g" "2026-03-07 00:00:00,2026-03-07 12:00:00,2026-03-08 00:00:00"]
  ["string_agg(g::text, ',' order by g) from generate_series('2026-01-01'::timestamp, '2026-01-02', '12 hours') g" "2026-01-01 00:00:00,2026-01-01 12:00:00,2026-01-02 00:00:00"]
  ["string_agg(g::text, ',' order by g) from generate_series(date '2026-01-30', date '2026-04-01', interval '1 month') g" "2026-01-30 00:00:00-05,2026-02-28 00:00:00-05,2026-03-28 00:00:00-04"]
  ["generate_series(timestamp '2026-03-07', timestamp '2026-03-08', interval '12 hours')" "2026-03-07 00:00:00"]
  ["pg_typeof(g) from generate_series(timestamp '2026-03-07', timestamp '2026-03-08', interval '12 hours') g limit 1" "timestamp without time zone"]
  ["pg_typeof(g) from generate_series(timestamptz '2026-03-07 00:00+00', timestamptz '2026-03-08 00:00+00', interval '12 hours') g limit 1" "timestamp with time zone"]
  ["count(*) from generate_series(timestamp '2026-03-08', timestamp '2026-03-07', interval '-6 hours')" "5"]
  ["count(*) from generate_series(timestamp '2026-03-08', timestamp '2026-03-07', interval '6 hours')" "0"]
  ["generate_series(timestamp '2026-03-07', timestamp '2026-03-08', interval '0 hours')" nil "step size cannot equal zero"]
  ["(date '2026-06-15', date '2026-06-20') overlaps (date '2026-06-18', date '2026-06-25')" "t"]
  ["(date '2026-06-15', date '2026-06-20') overlaps (date '2026-06-20', date '2026-06-25')" "f"]
  ["(date '2026-06-20', date '2026-06-15') overlaps (date '2026-06-18', date '2026-06-25')" "t"]
  ["(timestamp '2026-01-01', interval '1 day') overlaps (timestamp '2026-01-01 12:00', interval '1 hour')" "t"]
  ["(timestamp '2026-01-01', interval '1 day') overlaps (timestamp '2026-01-02', interval '1 hour')" "f"]
  ["(timestamptz '2026-03-07 12:00-05', interval '1 day') overlaps (timestamptz '2026-03-08 12:30-04', interval '1 hour')" "f"]
  ["((date '2026-06-15', null::date) overlaps (date '2026-06-18', date '2026-06-25')) is null" "t"]
  ["(date '2026-06-15', null::date) overlaps (date '2026-06-10', date '2026-06-25')" "t"]
  ["((null::date, null::date) overlaps (date '2026-06-10', date '2026-06-25')) is null" "t"]
  ["(date '2026-06-15', date '2026-06-15') overlaps (date '2026-06-15', date '2026-06-15')" "t"]
  ["(time '10:00', time '11:00') overlaps (time '10:30', time '12:00')" "t"]
  ["count(*) from (values (date '2026-01-01', date '2026-01-10'), (date '2026-02-01', date '2026-02-05')) v(a, b) where (a, b) overlaps (date '2026-01-05', date '2026-01-06')" "1"]
  ["pg_typeof((date '2026-06-15', date '2026-06-20') overlaps (date '2026-06-18', date '2026-06-25'))" "boolean"]
  ["* from (select date '2026-01-01' as a) v" "2026-01-01"]
  ["* from (values (date '2026-01-01')) v(a)" "2026-01-01"]
  ["* from (select timestamp '2026-01-01' as a) v" "2026-01-01 00:00:00"]
  ["pg_typeof(a) from (select date '2026-01-01' as a) v" "date"]
  ["a + 1 from (select date '2026-01-01' as a) v" "2026-01-02"]
  ["* from (select timestamptz '2026-01-01 10:00+02' as a) v" "2026-01-01 03:00:00-05"]
  ["* from (values (date '2026-01-01'), (date '2026-02-01')) v(a) order by a desc limit 1" "2026-02-01"]
]
