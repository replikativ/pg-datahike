;; Captured from PostgreSQL 17 under TimeZone America/Los_Angeles: the SQL
;; value functions read in the session zone, time/timetz extract, and pg_lsn_in. [sql result error-substring]
{:zone "America/Los_Angeles"
 :corpus [
  ["SELECT now()::time::text = localtime::text" "t" nil]
  ["SELECT now()::time(3)::text = localtime(3)::text" "t" nil]
  ["SELECT now()::timestamp::text = localtimestamp::text" "t" nil]
  ["SELECT current_date = now()::date" "t" nil]
  ["SELECT current_time = now()::timetz" "t" nil]
  ["SELECT extract(timezone_hour from current_time) = extract(timezone_hour from now())" "t" nil]
  ["SELECT '16/ae'::pg_lsn" "16/AE" nil]
  ["SELECT '0000016/00AE'::pg_lsn" "16/AE" nil]
  ["SELECT 'FFFFFFFF/FFFFFFFF'::pg_lsn" "FFFFFFFF/FFFFFFFF" nil]
  ["SELECT '0/0'::pg_lsn" "0/0" nil]
  ["SELECT pg_input_is_valid('16AE7F7', 'pg_lsn')" "f" nil]
  ["SELECT pg_input_is_valid(' 16/AE', 'pg_lsn')" "f" nil]
  ["SELECT pg_input_is_valid('16/AE ', 'pg_lsn')" "f" nil]
  ["SELECT pg_input_is_valid('123456789/1', 'pg_lsn')" "f" nil]
  ["SELECT pg_input_is_valid('16/AE', 'pg_lsn')" "t" nil]
  ["SELECT message, sql_error_code FROM pg_input_error_info('16AE7F7', 'pg_lsn')" "invalid input syntax for type pg_lsn: \"16AE7F7\"|22P02" nil]
  ["SELECT '16AE7F7'::pg_lsn" nil "invalid input syntax for type pg_lsn: \"16AE7F7\""]
  ["SELECT 'G/0'::pg_lsn" nil "invalid input syntax for type pg_lsn: \"G/0\""]
  ["SELECT '16/AE'::pg_lsn - '16/A0'::pg_lsn" "14" nil]
  ["SELECT now()::timetz::text = current_time::text" "t" nil]
  ["SELECT extract(timezone_hour from '10:00-07'::timetz), extract(timezone_minute from '10:00+05:30'::timetz), extract(timezone from '10:00+05:30'::timetz)" "-7|30|19800" nil]
  ["SELECT extract(hour from '10:00:30.5-07'::timetz), extract(second from '10:00:30.5-07'::timetz), extract(epoch from '10:00-07'::timetz)" "10|30.500000|61200.000000" nil]
  ["SELECT extract(milliseconds from '10:00:30.5'::time), extract(microseconds from '10:00:30.5'::time), extract(minute from '10:05'::time), extract(epoch from '10:00:00.25'::time)" "30500.000|30500000|5|36000.250000" nil]
  ["SELECT extract(MicroSeconds from '10:00:30.5'::time), extract(msecs from '10:00:30.5'::time), extract(hrs from '10:00'::time)" "30500000|30500.000|10" nil]
  ["SELECT extract(day from '10:00-07'::timetz)" nil "unit \"day\" not supported for type time with time zone"]
  ["SELECT extract(timezone from '10:00'::time)" nil "unit \"timezone\" not supported for type time without time zone"]
  ["SELECT extract(fortnight from '10:00'::time)" nil "unit \"fortnight\" not recognized for type time without time zone"]
  ["SELECT date_part('hour', '10:00'::time)" "10" nil]
 ]}
