 ;; These findings describe named statement ranges. A file can have further causes.
 :findings
 [{:id :simple-query-copy-continuation
   :file "copyselect" :lines [90 96] :state :covered :impact :wrong-result
   :detail "COPY-IN used to drop subsequent commands and retain only the first batch."}
  {:id :materialized-view-with-no-data
   :file "matview" :lines [17 21] :state :covered :impact :wrong-result
   :detail "The catalog used to report relispopulated true for an unpopulated view. The gate checks the flag, the scan SQLSTATE and refresh."}
  {:id :or-join-heap-exhaustion
   :file "join" :lines [3835 3836] :state :covered :impact :internal-error
   :detail "The frozen target exhausted its heap. The released guard can reject the Cartesian intermediate with 54000. The keyed integer disjunction now returns the native count of 20,000 on the original 10,000-row fixture with the limit enabled or disabled. A separate Cartesian regression verifies safe rejection."}
  {:id :date-trunc-calendar-boundaries
   :file "date" :lines [315 324] :state :covered :impact :wrong-result
   :detail "The date_trunc gate matches century, millennium, and decade boundaries for AD and BC dates and timestamps."}
  {:id :timestamp-date-trunc-units-and-infinity
   :file "timestamp" :lines [177 181] :state :covered :impact :wrong-result
   :detail "The gate checks ISO weeks, infinity, and the SQLSTATE difference between unknown and unsupported units."}
  {:id :timestamptz-date-trunc-units-and-zones
   :file "timestamptz" :lines [219 230] :state :covered :impact :wrong-result
   :detail "The gate checks ISO weeks, explicit zone names and abbreviations, and unit validation for finite and infinite values."}
  {:id :infinite-interval-date-bin
   :file "interval" :lines [772 773] :state :covered :impact :internal-error
   :detail "The untyped infinite strides used to reach a Java cast. The gate checks PostgreSQL SQLSTATE 22008 for both signs."}
  {:id :average-finite-intervals
   :file "interval" :lines [169 169] :state :covered :impact :internal-error
   :detail "The typed overload now averages stored intervals and isfinite filters both infinities. The gate checks the interval OID and value in the supported postgres output style."}
  {:id :unparenthesized-arithmetic-default
   :file "constraints" :lines [32 40] :state :covered :impact :unsupported
   :detail "The compound arithmetic default and the unquoted uppercase sequence name are covered by a pgwire regression. The upstream CREATE, INSERT and SELECT block matches PostgreSQL 18.6."}
  {:id :foreign-key-definition-validation
   :file "foreign_key" :lines [538 543] :state :covered :impact :wrong-result
   :detail "Invalid foreign keys previously left relations and dependencies behind. The gate checks missing and system columns, non-unique target keys, and a clean catalog after rejection."}
  {:id :alter-column-nullability
   :file "alter_table" :lines [876 908] :state :covered :impact :wrong-result
   :detail "SET and DROP NOT NULL on ordinary tables update enforcement and the catalog together. The gate checks rejecting existing NULL rows, atomic failure with multiple ALTER actions, and visibility before and after rollback."}
  {:id :alter-table-preserves-existing-default-values
   :file "fast_default" :lines [87 98] :state :covered :impact :wrong-result
   :detail "ADD COLUMN with a literal default fills existing rows. SET DEFAULT affects later writes, and short rows in a VALUES list remain separate rows."}
  {:id :expression-default-backfill
   :file "fast_default" :lines [67 67] :state :covered :impact :unsupported
   :detail "ADD COLUMN evaluates the typed volatile default per existing row. The gate includes the upstream random expression, transaction-stable timestamps, and UUID values that survive COMMIT."}
  {:id :fast-default-rewrite-event
   :file "fast_default" :lines [59 61] :state :boundary :impact :unsupported
   :detail "CREATE EVENT TRIGGER on table_rewrite is unsupported. A separate gate checks the volatile backfill's row values."}
  {:id :sample-column-identifier
   :file "tsearch" :lines [674 674] :state :covered :impact :unsupported
   :detail "SAMPLE behaves as an ordinary unquoted identifier when adding a tsquery column, then reading and updating it."}
  {:id :to-tsquery-function
   :file "tsearch" :lines [675 675] :state :open :impact :unsupported
   :detail "to_tsquery(unknown, text) returns 42883. The adjacent ALTER now succeeds, and ::tsquery handles the cast case."}
  {:id :scalar-domain-defaults
   :file "domain" :lines [386 421] :state :covered :impact :wrong-result
   :detail "Omitted fields use scalar domain defaults. Column DEFAULT NULL overrides them. The gate checks typed literals, a sequence expression, NOT NULL and COPY."}
  {:id :sequence-data-discovery
   :file "sequence" :lines [416 417] :state :open :impact :wrong-result
   :detail "pg_get_sequence_data now gives stock pg_dump both position fields. With CACHE 10 and three calls, native 18.6 reports the reserved upper value 10 and pg-datahike reports the handed-out value 3."}
  {:id :sequence-owner-syntax
   :file "sequence" :lines [14 14] :state :covered :impact :wrong-result
   :detail "A bare OWNED BY target other than NONE raises 42601. The failed CREATE leaves no sequence."}
  {:id :sequence-ownership-system-index
   :file "sequence" :lines [15 15] :state :open :impact :fixture
   :detail "User index owners raise 42809. This case needs the native pg_class_oid_index system relation in the catalog."}
  {:id :sequence-owner-schema-and-column
   :file "sequence" :lines [16 18] :state :covered :impact :wrong-result
   :detail "OWNED BY rejects cross-schema targets and missing columns with 55000 and 42703. The gate checks that failure leaves the catalog intact."}
  {:id :serial-sequence-discovery
   :file "sequence" :lines [63 63] :state :covered :impact :unsupported
   :detail "pg_get_serial_sequence reads SERIAL and IDENTITY ownership and reflects explicit attach and detach operations."}
  {:id :identity-sequence-options
   :file "identity" :lines [7 8] :state :covered :impact :unsupported
   :detail "CREATE TABLE applies typed identity sequence options. The gate checks the positions, catalog metadata, duplicate options, and rejection of a second ADD GENERATED."}
  {:id :identity-system-override
   :file "identity" :lines [68 72] :state :covered :impact :unsupported
   :detail "Explicit identity values restore with OVERRIDING SYSTEM VALUE. Mixed VALUES rows still allocate DEFAULT through the owned sequence."}
  {:id :identity-user-override
   :file "identity" :lines [74 78] :state :open :impact :unsupported
   :detail "OVERRIDING USER VALUE still needs PostgreSQL's separate treatment of ignored identity input expressions."}
  {:id :identity-update-default
   :file "identity" :lines [119 126] :state :covered :impact :wrong-result
   :detail "UPDATE DEFAULT uses the owned sequence for both identity modes. An explicit UPDATE of GENERATED ALWAYS still raises 428C9."}
  {:id :alter-comment-missing-relation
   :file "alter_table" :lines [18 18] :state :open :impact :wrong-result
   :detail "COMMENT ON a missing relation succeeds on the target. Native 18.6 rejects it before the ordinary-table migration statements."}
  {:id :alter-reserved-system-column
   :file "alter_table" :lines [22 22] :state :covered :impact :wrong-result
   :detail "The gate checks SQLSTATE 42701 for reserved system column names across CREATE TABLE, CTAS, ADD COLUMN, and RENAME COLUMN. Rejected statements leave the relation and column catalogs intact."}
  {:id :conflict-operator-class-index
   :file "insert_conflict" :lines [13 16] :state :open :impact :unsupported
   :detail "The first independent failure is CREATE UNIQUE INDEX with text_pattern_ops. Later ON CONFLICT arbiter differences depend on those indexes. EXPLAIN INSERT has a separate parser gap."}
  {:id :returning-update-source-binding
   :file "returning" :lines [41 44] :state :covered :impact :unsupported
   :detail "UPDATE FROM returns the updated target and the selected source tuple. The gate also checks typed Describe, star expansion, CTEs, and source correlation."}
  {:id :returning-delete-source-binding
   :file "returning" :lines [48 51] :state :covered :impact :wrong-result
   :detail "DELETE USING requires a matching source row and returns that row with the old target. The gate also checks an empty source, duplicate matches, and rollback."}
  {:id :returning-old-new-grammar
   :file "returning" :lines [217 218] :state :open :impact :unsupported
   :detail "RETURNING WITH (OLD AS ..., NEW AS ...) requires parser support and separate old and new target scopes."}
  {:id :reset-transaction-isolation
   :file "transactions" :lines [39 42] :state :covered :impact :wrong-result
   :detail "RESET of a current transaction characteristic now returns 0A000. The gate checks that the transaction then returns 25P02 until rollback."}
  {:id :database-rename-fixture
   :file "database" :lines [1 5] :state :boundary :impact :fixture
   :detail "Unsupported rename leaves a run-created database under the original name."}
  {:id :legacy-copy-force-quote
   :file "copyselect" :lines [65 65] :state :covered :impact :unsupported
   :detail "The legacy FORCE QUOTE column list now uses the existing CSV formatter. The upstream query COPY emits the same header and quoted value as PostgreSQL 18.6."}
  {:id :array-sort
   :file "arrays" :lines [865 868] :state :covered :impact :unsupported
   :detail "Integer and numeric array_sort matches PostgreSQL 18.6. Additional strict slices exercise direction, NULL placement, multidimensional order and lower bounds."}
  {:id :array-sort-other-orderings
   :file "arrays" :lines [869 871] :state :open :impact :unsupported
   :detail "The implemented orderings cover numeric and Boolean elements. Collated text and int2vector ordering still need parity."}
  {:id :create-table-as-execute
   :file "prepare" :lines [62 66] :state :covered :impact :unsupported
   :detail "Prepared SELECT results can populate a table in source column order. WITH NO DATA evaluates arguments and leaves the table empty. The upstream 10,000-row fixture matches PostgreSQL 18.6 for both forms."}
  {:id :time-variable-zone-requires-date
   :file "time" :lines [17 20] :state :covered :impact :wrong-result
   :detail "Named zones with variable offsets require a date. The gate verifies SQLSTATE 22007 and a row count unaffected by a rejected insert."}
  {:id :time-variable-zone-input-api
   :file "time" :lines [46 48] :state :covered :impact :wrong-result
   :detail "A missing date for America/New_York is reported through pg_input_is_valid and pg_input_error_info."}
  {:id :timestamp-relative-input
   :file "timestamp" :lines [13 45] :state :covered :impact :unsupported
   :detail "Relative dates accept zone suffixes without changing the wall clock. Across transactions now changes, and within a transaction both inserts and queries use the same clock."}
  {:id :timestamptz-relative-input
   :file "timestamptz" :lines [13 46] :state :covered :impact :unsupported
   :detail "Relative dates resolve in the session zone or an explicit offset. Consecutive transactions get distinct values for now, with matching values within a transaction."}
  {:id :timestamptz-dynamic-zone-abbreviation
   :file "timestamptz" :lines [569 577] :state :covered :impact :unsupported
   :detail "AT TIME ZONE uses the historical offset attached to MSK across the 2011 Moscow spring gap."}
  {:id :timestamptz-dynamic-zone-overlap
   :file "timestamptz" :lines [585 592] :state :covered :impact :unsupported
   :detail "AT TIME ZONE and make_timestamptz use the historical MSK offset across the 2014 Moscow overlap."}
  {:id :timestamptz-dynamic-zone-from-instant
   :file "timestamptz" :lines [638 650] :state :covered :impact :unsupported
   :detail "Instant-to-wall-clock conversion uses the MSK offset on the correct side of each Moscow transition."}
  {:id :timestamptz-at-local
   :file "timestamptz" :lines [655 661] :state :covered :impact :unsupported
   :detail "Timestamp conversions use the session zone for both direction changes, including after a prepared statement is reused."}
  {:id :timetz-local-view
   :file "timetz" :lines [91 100] :state :covered :impact :unsupported
   :detail "AT LOCAL in a timetz view produces the same row values as timezone(value), the UTC name and the UTC interval."}
  {:id :timetz-addition-diagnostic
   :file "timetz" :lines [64 64] :state :covered :impact :internal-error
   :detail "Adding two timetz values raises SQLSTATE 42883 during analysis, including on an empty table."}
  {:id :timetz-interval-offset
   :file "timetz" :lines [103 107] :state :covered :impact :unsupported
   :detail "Stored timetz values produce the same results with a POSIX name and an equivalent interval. The gate also checks stored intervals and timezone(interval, value)."}
  {:id :virtual-generated-columns
   :file "generated_virtual" :lines [8 9] :state :boundary :impact :unsupported
   :detail "VIRTUAL generated columns are explicitly rejected."}
  {:id :grouping-family
   :file "groupingsets" :lines [87 106] :state :boundary :impact :unsupported
   :detail "GROUPING SETS, ROLLUP, and CUBE are rejected before materialization."}]}
