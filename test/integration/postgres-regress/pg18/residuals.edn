 ;; These findings describe named statement ranges. A file can have further causes.
 :findings
 [{:id :simple-query-copy-continuation
   :file "copyselect" :lines [90 96] :state :covered :impact :wrong-result
   :detail "COPY-IN used to drop subsequent commands and retain only the first batch."}
  {:id :materialized-view-with-no-data
   :file "matview" :lines [17 21] :state :covered :impact :wrong-result
   :detail "The catalog used to report relispopulated true for an unpopulated view. The gate checks the flag, the scan SQLSTATE and refresh."}
  {:id :or-join-heap-exhaustion
   :file "join" :lines [3835 3836] :state :covered :impact :internal-error
   :detail "The frozen target exhausted its heap. The released guard can reject the Cartesian intermediate with 54000. The keyed integer disjunction now returns the native count of 20,000 on the original 10,000-row fixture with the limit enabled or disabled. A separate Cartesian regression verifies safe rejection."}
  {:id :infinite-interval-date-bin
   :file "interval" :lines [772 773] :state :covered :impact :internal-error
   :detail "The untyped infinite strides used to reach a Java cast. The gate checks PostgreSQL SQLSTATE 22008 for both signs."}
  {:id :average-finite-intervals
   :file "interval" :lines [169 169] :state :covered :impact :internal-error
   :detail "The typed overload now averages stored intervals and isfinite filters both infinities. The gate checks the interval OID and value in the supported postgres output style."}
  {:id :unparenthesized-arithmetic-default
   :file "constraints" :lines [32 40] :state :covered :impact :unsupported
   :detail "The compound arithmetic default and the unquoted uppercase sequence name are covered by a pgwire regression. The upstream CREATE, INSERT and SELECT block matches PostgreSQL 18.6."}
  {:id :foreign-key-definition-validation
   :file "foreign_key" :lines [538 543] :state :covered :impact :wrong-result
   :detail "Invalid foreign keys previously left relations and dependencies behind. The gate checks missing and system columns, non-unique target keys, and a clean catalog after rejection."}
  {:id :alter-column-nullability
   :file "alter_table" :lines [876 908] :state :covered :impact :wrong-result
   :detail "SET and DROP NOT NULL on ordinary tables update enforcement and the catalog together. The gate checks rejecting existing NULL rows, atomic failure with multiple ALTER actions, and visibility before and after rollback."}
  {:id :alter-table-preserves-existing-default-values
   :file "fast_default" :lines [87 98] :state :covered :impact :wrong-result
   :detail "ADD COLUMN with a literal default fills existing rows. SET DEFAULT affects later writes, and short rows in a VALUES list remain separate rows."}
  {:id :expression-default-backfill
   :file "fast_default" :lines [67 67] :state :open :impact :unsupported
   :detail "Adding a column with an expression default to a populated table requires backfill evaluation. The volatile default case needs a separate value per existing row."}
  {:id :sequence-data-discovery
   :file "sequence" :lines [416 417] :state :open :impact :unsupported
   :detail "PostgreSQL 18 pg_dump uses pg_get_sequence_data to read last_value and is_called in data-bearing dumps. Schema-only pg_dump and direct COPY pass the ordinary fixture."}
  {:id :reset-transaction-isolation
   :file "transactions" :lines [39 42] :state :covered :impact :wrong-result
   :detail "RESET of a current transaction characteristic now returns 0A000. The gate checks that the transaction then returns 25P02 until rollback."}
  {:id :database-rename-fixture
   :file "database" :lines [1 5] :state :boundary :impact :fixture
   :detail "Unsupported rename leaves a run-created database under the original name."}
  {:id :legacy-copy-force-quote
   :file "copyselect" :lines [65 65] :state :covered :impact :unsupported
   :detail "The legacy FORCE QUOTE column list now uses the existing CSV formatter. The upstream query COPY emits the same header and quoted value as PostgreSQL 18.6."}
  {:id :array-sort
   :file "arrays" :lines [865 868] :state :covered :impact :unsupported
   :detail "Integer and numeric array_sort matches PostgreSQL 18.6. Additional strict slices exercise direction, NULL placement, multidimensional order and lower bounds."}
  {:id :array-sort-other-orderings
   :file "arrays" :lines [869 871] :state :open :impact :unsupported
   :detail "The implemented orderings cover numeric and Boolean elements. Collated text and int2vector ordering still need parity."}
  {:id :create-table-as-execute
   :file "prepare" :lines [62 66] :state :covered :impact :unsupported
   :detail "Prepared SELECT results can populate a table in source column order. WITH NO DATA evaluates arguments and leaves the table empty. The upstream 10,000-row fixture matches PostgreSQL 18.6 for both forms."}
  {:id :virtual-generated-columns
   :file "generated_virtual" :lines [8 9] :state :boundary :impact :unsupported
   :detail "VIRTUAL generated columns are explicitly rejected."}
  {:id :grouping-family
   :file "groupingsets" :lines [87 106] :state :boundary :impact :unsupported
   :detail "GROUPING SETS, ROLLUP, and CUBE are rejected before materialization."}]}
