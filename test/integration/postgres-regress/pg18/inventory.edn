 {"compression_pglz"
  {:scope :out-of-scope,
   :source-lines [5 63],
   :basis
   "Native C regress-library PGLZ round-trip and corrupt-buffer mechanics; does not exclude SQL bytea/string semantics."},
  "copyencoding"
  {:scope :backlog,
   :source-lines [5 53],
   :basis
   "COPY ENCODING and client_encoding are client-visible. Requires UTF8 server and PG_ABS_BUILDDIR file context; fixture dependence is not a semantic exclusion."},
  "encoding"
  {:scope :backlog,
   :source-lines [1 29],
   :basis
   "Mixed encoding validation/conversion and deliberately corrupt-string native helpers. C helpers require regress library; reusable client-visible assertions remain in scope."},
  "euc_kr"
  {:scope :backlog,
   :source-lines [1 12],
   :basis "Client conversion/POSITION semantics on EUC_KR data, also runnable with UTF8 server encoding."},
  "event_trigger"
  {:scope :backlog,
   :source-lines [1 40],
   :basis "DDL event-trigger functions are a compatibility follow-up, not an established product non-goal."},
  "event_trigger_login"
  {:scope :backlog,
   :source-lines [1 24],
   :basis "Login event triggers and reconnect effects are a distinct client/lifecycle follow-up."},
  "generated_stored"
  {:scope :campaign,
   :source-lines [4 113],
   :predecessor "generated",
   :basis
   "Changed split successor, not a byte-for-byte rename: schema-qualified catalog probes, whole-row/sublink reads, RETURNING OLD/NEW and MERGE cases. No prior slices admitted."},
  "generated_virtual"
  {:scope :backlog,
   :source-lines [4 83],
   :basis
   "Distinct virtual generated-column surface, including errors at read rather than write; no inherited stored-column coverage."},
  "numa"
  {:scope :out-of-scope,
   :source-lines [1 10],
   :basis "pg_numa_available and pg_shmem_allocations_numa inspect server shared-memory topology."},
  "numeric_big"
  {:scope :backlog,
   :basis
   "Unscheduled numeric regression remains an explicit application-facing input; it is not an additional scheduled file."},
  "object_address"
  {:scope :backlog,
   :source-lines [1 55],
   :basis
   "pg_get_object_address and object identity/introspection are client-facing; broad foreign/native/privilege fixtures must be classified separately."},
  "plpgsql"
  {:scope :backlog,
   :source-lines [1 38],
   :basis
   "Client-facing procedural execution; mixed native/helper and shared-schedule dependencies do not justify a blanket language exclusion."},
  "psql_pipeline"
  {:scope :backlog,
   :source-lines [5 115],
   :basis
   "PG18 psql extended-query pipeline parse/bind/flush/sync and implicit/explicit transaction behavior; requires PG18 client, not a physical server mechanism."},
  "reindex_catalog"
  {:scope :out-of-scope,
   :basis
   "Unscheduled REINDEX TABLE/INDEX on PostgreSQL system catalogs tests physical catalog maintenance, not logical SQL index lifecycle."},
  "stats_import"
  {:scope :out-of-scope,
   :source-lines [23 40],
   :basis
   "pg_restore_relation_stats/pg_restore_attribute_stats import PostgreSQL physical/planner statistics; ordinary catalog projections remain client scope."},
  "without_overlaps"
  {:scope :backlog,
   :source-lines [8 84],
   :basis
   "Application-visible temporal uniqueness/foreign-key semantics and deparsed constraints; range/GiST dependencies are separate implementation boundaries."}},
