<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Connection to Datahike PgWire -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://127.0.0.1:15432/datahike?preferQueryMode=simple</property>
        <property name="hibernate.connection.username">datahike</property>
        <property name="hibernate.connection.password"></property>

        <!-- PostgreSQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- DDL: create tables automatically -->
        <property name="hibernate.hbm2ddl.auto">create</property>

        <!-- Show SQL for debugging -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Entity classes -->
        <mapping class="io.replikativ.test.Department"/>
        <mapping class="io.replikativ.test.Employee"/>
    </session-factory>
</hibernate-configuration>
