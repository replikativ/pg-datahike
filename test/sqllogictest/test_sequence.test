# test_sequence.test
# SQL SEQUENCE support (CREATE SEQUENCE, nextval, currval, DROP SEQUENCE)

# ============================================================
# CREATE SEQUENCE with defaults
# ============================================================

statement ok
CREATE SEQUENCE test_seq START WITH 1 INCREMENT BY 1

# ============================================================
# nextval increments and returns. PG semantics: the first nextval
# after CREATE SEQUENCE START WITH N returns exactly N.
# ============================================================

query I rowsort
SELECT nextval('test_seq')
----
1

query I rowsort
SELECT nextval('test_seq')
----
2

# ============================================================
# currval returns last value
# ============================================================

query I rowsort
SELECT currval('test_seq')
----
2

# ============================================================
# Sequence with custom increment (Hibernate pattern)
# ============================================================

statement ok
CREATE SEQUENCE hibernate_seq START WITH 1 INCREMENT BY 50

query I rowsort
SELECT nextval('hibernate_seq')
----
1

query I rowsort
SELECT nextval('hibernate_seq')
----
51

# ============================================================
# DROP SEQUENCE
# ============================================================

statement ok
DROP SEQUENCE IF EXISTS test_seq

statement ok
DROP SEQUENCE IF EXISTS hibernate_seq

# Dropping non-existent sequence with IF EXISTS should succeed
statement ok
DROP SEQUENCE IF EXISTS nonexistent_seq
