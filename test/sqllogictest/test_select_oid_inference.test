# test_select_oid_inference.test
#
# SELECT-list OID inference coverage — exercises each rule in
# datahike.pg.sql.oid-infer so a typing regression surfaces as a
# row-format mismatch here (sqllogictest coerces values per column
# type I/R/T; if the OID flips, the result set still formats but the
# wire protocol would lose client-side typing).
#
# Unit tests in pg_extended_query_oid_test.clj assert the OIDs
# directly; this file complements them by exercising the same shapes
# through the full execute pipeline.

statement ok
CREATE TABLE t (id INT PRIMARY KEY, name TEXT, salary DOUBLE PRECISION, active BOOLEAN)

statement ok
INSERT INTO t VALUES (1, 'Alice',   90000, TRUE),
                    (2, 'Bob',     80000, TRUE),
                    (3, 'Charlie', 70000, FALSE)

# ---------------------------------------------------------------------------
# Table-free literal SELECT (no FROM)
# ---------------------------------------------------------------------------

query I rowsort
SELECT 1
----
1

query R rowsort
SELECT 1.5
----
1.500000

query T rowsort
SELECT 'hello'
----
hello

# SELECT TRUE now materialises as Boolean, not the string "true".
# Our formatter emits 't'/'f' for boolean columns per PG text format.
query T rowsort
SELECT TRUE
----
t

query T rowsort
SELECT FALSE
----
f

query T rowsort
SELECT NULL
----
NULL

# Mixed types in a single tuple — widest-match per column
query TI rowsort
SELECT 'x', 2
----
x	2

# ---------------------------------------------------------------------------
# Schema columns
# ---------------------------------------------------------------------------

query I rowsort
SELECT id FROM t
----
1
2
3

query T rowsort
SELECT name FROM t
----
Alice
Bob
Charlie

query R rowsort
SELECT salary FROM t
----
70000.000000
80000.000000
90000.000000

# ---------------------------------------------------------------------------
# Aggregates — COUNT is INT8; SUM/AVG/MIN/MAX propagate arg type
# ---------------------------------------------------------------------------

query I rowsort
SELECT COUNT(*) FROM t
----
3

query I rowsort
SELECT COUNT(name) FROM t
----
3

query R rowsort
SELECT SUM(salary) FROM t
----
240000.000000

query R rowsort
SELECT AVG(salary) FROM t
----
80000.000000

query R rowsort
SELECT MAX(salary) FROM t
----
90000.000000

query R rowsort
SELECT MIN(salary) FROM t
----
70000.000000

query I rowsort
SELECT MIN(id), MAX(id) FROM t
----
1	3

# ---------------------------------------------------------------------------
# Scalar functions — return-type registry
# ---------------------------------------------------------------------------

query I rowsort
SELECT LENGTH(name) FROM t ORDER BY id
----
5
3
7

query T rowsort
SELECT LOWER(name) FROM t ORDER BY id
----
alice
bob
charlie

query T rowsort
SELECT UPPER(name) FROM t ORDER BY id
----
ALICE
BOB
CHARLIE

query T rowsort
SELECT COALESCE(name, 'N/A') FROM t ORDER BY id
----
Alice
Bob
Charlie

# ---------------------------------------------------------------------------
# Binary arithmetic — numeric promotion
#
# Note: arithmetic on bare literals (SELECT 1 + 2) isn't constant-folded
# by the table-free parser — it falls through as a string. Once we have
# FROM, translate-expr evaluates properly via Datalog function bindings.
# ---------------------------------------------------------------------------

query I rowsort
SELECT id + 10 FROM t ORDER BY id
----
11
12
13

# Mixed int + double → float8
query R rowsort
SELECT salary * 2 FROM t ORDER BY id
----
180000.000000
160000.000000
140000.000000

query T rowsort
SELECT name || ' (emp)' FROM t ORDER BY id
----
Alice (emp)
Bob (emp)
Charlie (emp)

# ---------------------------------------------------------------------------
# Comparisons and logical → BOOL
# Previously threw `Unsupported SQL expression` when used as
# projection; now legal, via translate-expr → translate-predicate-expr
# delegation.
# ---------------------------------------------------------------------------

query T rowsort
SELECT salary > 75000 FROM t ORDER BY id
----
t
t
f

query T rowsort
SELECT name IS NULL FROM t ORDER BY id
----
f
f
f

query T rowsort
SELECT NOT (id = 1) FROM t ORDER BY id
----
f
t
t

# ---------------------------------------------------------------------------
# CAST — target type → result OID
# ---------------------------------------------------------------------------

query I rowsort
SELECT CAST('42' AS BIGINT)
----
42

query I rowsort
SELECT CAST(salary AS BIGINT) FROM t ORDER BY id
----
90000
80000
70000

query T rowsort
SELECT CAST(1 AS TEXT)
----
1

# ---------------------------------------------------------------------------
# CASE — type of first WHEN branch
# ---------------------------------------------------------------------------

query T rowsort
SELECT CASE WHEN id > 1 THEN 'many' ELSE 'one' END FROM t ORDER BY id
----
one
many
many

query I rowsort
SELECT CASE WHEN id > 1 THEN 100 ELSE 200 END FROM t ORDER BY id
----
200
100
100
